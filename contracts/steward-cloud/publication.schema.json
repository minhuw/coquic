{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.dev/contracts/steward-cloud/publication.schema.json",
  "title": "Steward clean staged publication and usage payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationId",
    "taskId",
    "generation",
    "headIntent",
    "task",
    "pipelines",
    "runs",
    "events",
    "artifacts",
    "usage"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "publicationId": {"$ref": "#/$defs/id"},
    "taskId": {"$ref": "#/$defs/id"},
    "generation": {"$ref": "#/$defs/generation"},
    "headIntent": {"$ref": "#/$defs/headIntent"},
    "task": {"$ref": "#/$defs/task"},
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/pipeline"}
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/run"}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {"$ref": "#/$defs/event"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nullableSafeInteger": {
      "anyOf": [
        {"$ref": "#/$defs/safeInteger"},
        {"type": "null"}
      ]
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*://)(?!.*\\.\\.)[^\\u0000-\\u001f]+$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s]+$"
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redactionApplied", "originalRetained"],
      "properties": {
        "redactionApplied": {"type": "boolean"},
        "originalRetained": {"type": "boolean"}
      }
    },
    "expectedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "pipelines", "runs", "events", "artifacts"],
      "properties": {
        "tasks": {"const": 1},
        "pipelines": {"$ref": "#/$defs/safeInteger"},
        "runs": {"$ref": "#/$defs/safeInteger"},
        "events": {"$ref": "#/$defs/safeInteger"},
        "artifacts": {"$ref": "#/$defs/safeInteger"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationId", "taskId", "runId", "metadataDigest", "idempotencyKey",
        "state", "expectedCounts", "createdAt"
      ],
      "properties": {
        "publicationId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "metadataDigest": {"$ref": "#/$defs/digest"},
        "idempotencyKey": {"$ref": "#/$defs/id"},
        "state": {"const": "staged"},
        "expectedCounts": {"$ref": "#/$defs/expectedCounts"},
        "createdAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "headIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationId", "taskId", "state", "updatedAt"],
      "properties": {
        "publicationId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "state": {"enum": ["visible", "hidden"]},
        "updatedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "title", "lifecycleState", "createdAt", "completedAt"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/shortText"},
        "lifecycleState": {"enum": ["active", "completed", "failed", "cancelled"]},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineId", "taskId", "name", "createdAt"],
      "properties": {
        "pipelineId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "createdAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId", "taskId", "pipelineId", "role", "runState", "startedAt",
        "completedAt", "durationMs", "atifDigest", "atifArtifactId"
      ],
      "properties": {
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "pipelineId": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "runState": {"enum": ["completed", "failed", "cancelled"]},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "durationMs": {"$ref": "#/$defs/safeInteger"},
        "atifDigest": {"$ref": "#/$defs/digest"},
        "atifArtifactId": {"$ref": "#/$defs/id"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sequence", "eventType", "occurredAt", "summary"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "eventType": {"type": "string", "minLength": 1, "maxLength": 128},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "summary": {"type": "string", "maxLength": 4096}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId", "taskId", "runId", "logicalPath", "publicKey", "mediaType",
        "byteSize", "sha256", "availability", "disclosure"
      ],
      "properties": {
        "artifactId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "logicalPath": {"$ref": "#/$defs/logicalPath"},
        "publicKey": {"type": "string", "pattern": "^v1/tasks/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"},
        "mediaType": {"$ref": "#/$defs/mediaType"},
        "byteSize": {"$ref": "#/$defs/safeInteger"},
        "sha256": {"$ref": "#/$defs/digest"},
        "availability": {"enum": ["available", "unavailable"]},
        "disclosure": {"$ref": "#/$defs/disclosure"}
      }
    },
    "coverage": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "nullableToken": {"$ref": "#/$defs/nullableSafeInteger"},
    "nullableCost": {"$ref": "#/$defs/nullableSafeInteger"},
    "tokenFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptTokens", "cachedTokens", "uncachedTokens", "completionTokens",
        "reasoningTokens", "totalTokens"
      ],
      "properties": {
        "promptTokens": {"$ref": "#/$defs/nullableToken"},
        "cachedTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedTokens": {"$ref": "#/$defs/nullableToken"},
        "completionTokens": {"$ref": "#/$defs/nullableToken"},
        "reasoningTokens": {"$ref": "#/$defs/nullableToken"},
        "totalTokens": {"$ref": "#/$defs/nullableToken"}
      }
    },
    "costFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncachedInputCostMicroUsd", "cachedInputCostMicroUsd",
        "outputCostMicroUsd", "totalCostMicroUsd"
      ],
      "properties": {
        "uncachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "cachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "outputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "totalCostMicroUsd": {"$ref": "#/$defs/nullableCost"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summaryId", "usageGenerationId", "publicationId", "taskId", "runId", "scope", "coverage",
        "coveredInvocations", "expectedInvocations", "knownTokenSubtotal",
        "knownCostSubtotalMicroUsd", "promptTokens", "cachedTokens", "uncachedTokens",
        "completionTokens", "reasoningTokens", "totalTokens", "uncachedInputCostMicroUsd",
        "cachedInputCostMicroUsd", "outputCostMicroUsd", "totalCostMicroUsd",
        "priceProvenanceDigest"
      ],
      "properties": {
        "summaryId": {"$ref": "#/$defs/id"},
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "publicationId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "runId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "scope": {"enum": ["task", "run"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "coveredInvocations": {"$ref": "#/$defs/safeInteger"},
        "expectedInvocations": {"$ref": "#/$defs/safeInteger"},
        "knownTokenSubtotal": {"$ref": "#/$defs/nullableSafeInteger"},
        "knownCostSubtotalMicroUsd": {"$ref": "#/$defs/nullableSafeInteger"},
        "promptTokens": {"$ref": "#/$defs/nullableToken"},
        "cachedTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedTokens": {"$ref": "#/$defs/nullableToken"},
        "completionTokens": {"$ref": "#/$defs/nullableToken"},
        "reasoningTokens": {"$ref": "#/$defs/nullableToken"},
        "totalTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "cachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "outputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "totalCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "priceProvenanceDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "task"}}}, "then": {"properties": {"runId": {"type": "null"}}}},
        {"if": {"properties": {"scope": {"const": "run"}}}, "then": {"required": ["runId"], "properties": {"runId": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"coverage": {"const": "unavailable"}}}, "then": {"properties": {"knownTokenSubtotal": {"type": "null"}, "knownCostSubtotalMicroUsd": {"type": "null"}}}}
      ]
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId", "usageGenerationId", "publicationId", "taskId", "pipelineId",
        "runId", "ownershipClass", "retryOrdinal", "startedAt", "completedAt", "model",
        "billingMode", "processOutcome", "coverage", "issueCount", "coveredTurns",
        "expectedTurns", "promptTokens", "cachedTokens", "uncachedTokens", "completionTokens",
        "reasoningTokens", "totalTokens", "uncachedInputCostMicroUsd", "cachedInputCostMicroUsd",
        "outputCostMicroUsd", "totalCostMicroUsd", "priceEntryDigest"
      ],
      "properties": {
        "invocationId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "publicationId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "taskId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "pipelineId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "runId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "ownershipClass": {"enum": ["task-owned", "steward-overhead"]},
        "retryOrdinal": {"$ref": "#/$defs/safeInteger"},
        "startedAt": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "completedAt": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "model": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]},
        "billingMode": {"enum": ["unknown", "chatgpt", "api", null]},
        "processOutcome": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 48}, {"type": "null"}]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "issueCount": {"$ref": "#/$defs/safeInteger"},
        "coveredTurns": {"type": "integer", "minimum": 0, "maximum": 4096},
        "expectedTurns": {"type": "integer", "minimum": 0, "maximum": 4096},
        "promptTokens": {"$ref": "#/$defs/nullableToken"},
        "cachedTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedTokens": {"$ref": "#/$defs/nullableToken"},
        "completionTokens": {"$ref": "#/$defs/nullableToken"},
        "reasoningTokens": {"$ref": "#/$defs/nullableToken"},
        "totalTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "cachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "outputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "totalCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "priceEntryDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"ownershipClass": {"const": "task-owned"}}},
          "then": {"required": ["publicationId", "taskId", "pipelineId", "runId"]}
        },
        {
          "if": {"properties": {"ownershipClass": {"const": "steward-overhead"}}},
          "then": {
            "properties": {
              "publicationId": {"type": "null"},
              "taskId": {"type": "null"},
              "pipelineId": {"type": "null"},
              "runId": {"type": "null"},
              "coveredTurns": {"const": 0},
              "expectedTurns": {"const": 0}
            }
          }
        },
        {
          "if": {"properties": {"coverage": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "promptTokens": {"type": "null"},
              "cachedTokens": {"type": "null"},
              "uncachedTokens": {"type": "null"},
              "completionTokens": {"type": "null"},
              "reasoningTokens": {"type": "null"},
              "totalTokens": {"type": "null"},
              "uncachedInputCostMicroUsd": {"type": "null"},
              "cachedInputCostMicroUsd": {"type": "null"},
              "outputCostMicroUsd": {"type": "null"},
              "totalCostMicroUsd": {"type": "null"}
            }
          }
        }
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnId", "usageGenerationId", "invocationId", "publicationId", "taskId", "runId",
        "ordinal", "promptTokens", "cachedTokens", "uncachedTokens", "completionTokens",
        "reasoningTokens", "totalTokens", "uncachedInputCostMicroUsd", "cachedInputCostMicroUsd",
        "outputCostMicroUsd", "totalCostMicroUsd", "priceEntryDigest"
      ],
      "properties": {
        "turnId": {"$ref": "#/$defs/id"},
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "invocationId": {"$ref": "#/$defs/id"},
        "publicationId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4096},
        "promptTokens": {"$ref": "#/$defs/safeInteger"},
        "cachedTokens": {"$ref": "#/$defs/safeInteger"},
        "uncachedTokens": {"$ref": "#/$defs/safeInteger"},
        "completionTokens": {"$ref": "#/$defs/safeInteger"},
        "reasoningTokens": {"$ref": "#/$defs/safeInteger"},
        "totalTokens": {"$ref": "#/$defs/safeInteger"},
        "uncachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "cachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "outputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "totalCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "priceEntryDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceEntryDigest", "usageGenerationId", "catalogDigest", "model", "effectiveAt", "effectiveUntil"],
      "properties": {
        "priceEntryDigest": {"$ref": "#/$defs/digest"},
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "effectiveAt": {"$ref": "#/$defs/timestamp"},
        "effectiveUntil": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId", "usageGenerationId", "periodKind", "periodKey", "model", "ownershipClass",
        "coverage", "coveredInvocations", "expectedInvocations", "knownTokenSubtotal",
        "knownCostSubtotalMicroUsd", "promptTokens", "cachedTokens", "uncachedTokens",
        "completionTokens", "reasoningTokens", "totalTokens", "uncachedInputCostMicroUsd",
        "cachedInputCostMicroUsd", "outputCostMicroUsd", "totalCostMicroUsd", "priceProvenanceDigest",
        "aggregateOnly"
      ],
      "properties": {
        "globalId": {"$ref": "#/$defs/id"},
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "periodKind": {"enum": ["lifetime", "daily"]},
        "periodKey": {"type": "string", "pattern": "^(?:lifetime|20[0-9]{2}-[0-9]{2}-[0-9]{2})$"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "ownershipClass": {"enum": ["task-owned", "steward-overhead"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "coveredInvocations": {"$ref": "#/$defs/safeInteger"},
        "expectedInvocations": {"$ref": "#/$defs/safeInteger"},
        "knownTokenSubtotal": {"$ref": "#/$defs/nullableSafeInteger"},
        "knownCostSubtotalMicroUsd": {"$ref": "#/$defs/nullableSafeInteger"},
        "promptTokens": {"$ref": "#/$defs/nullableToken"},
        "cachedTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedTokens": {"$ref": "#/$defs/nullableToken"},
        "completionTokens": {"$ref": "#/$defs/nullableToken"},
        "reasoningTokens": {"$ref": "#/$defs/nullableToken"},
        "totalTokens": {"$ref": "#/$defs/nullableToken"},
        "uncachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "cachedInputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "outputCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "totalCostMicroUsd": {"$ref": "#/$defs/nullableCost"},
        "priceProvenanceDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "aggregateOnly": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"periodKind": {"const": "lifetime"}}}, "then": {"properties": {"periodKey": {"const": "lifetime"}}}},
        {"if": {"properties": {"periodKind": {"const": "daily"}}}, "then": {"properties": {"periodKey": {"pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"}}}},
        {"if": {"properties": {"ownershipClass": {"const": "steward-overhead"}}}, "then": {"properties": {"aggregateOnly": {"const": true}}}},
        {"if": {"properties": {"coverage": {"const": "unavailable"}}}, "then": {"properties": {"knownTokenSubtotal": {"type": "null"}, "knownCostSubtotalMicroUsd": {"type": "null"}}}}
      ]
    },
    "usageGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageGenerationId", "publicationId", "taskId", "schemaVersion", "metadataDigest",
        "state", "expectedCounts", "createdAt"
      ],
      "properties": {
        "usageGenerationId": {"$ref": "#/$defs/id"},
        "publicationId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "schemaVersion": {"const": "1.0"},
        "metadataDigest": {"$ref": "#/$defs/digest"},
        "state": {"const": "staged"},
        "expectedCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summaries", "invocations", "turns", "prices", "globals"],
          "properties": {
            "summaries": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "invocations": {"$ref": "#/$defs/safeInteger"},
            "turns": {"type": "integer", "minimum": 0, "maximum": 4096},
            "prices": {"$ref": "#/$defs/safeInteger"},
            "globals": {"$ref": "#/$defs/safeInteger"}
          }
        },
        "createdAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generation", "summaries", "invocations", "turns", "prices", "globals"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "generation": {"$ref": "#/$defs/usageGeneration"},
        "summaries": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/summary"}},
        "invocations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/invocation"}},
        "turns": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/turn"}},
        "prices": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/price"}},
        "globals": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/global"}}
      }
    }
  }
}

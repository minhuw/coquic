{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.minhuw.dev/contracts/steward-live/live-state.schema.json",
  "title": "CoQUIC Steward live state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedAt",
    "staleAfterSeconds",
    "daemon",
    "signals",
    "planning",
    "tasks",
    "integration",
    "availability"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "staleAfterSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "daemon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["production", "dry-run"]
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending"],
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["active", "idle", "paused"]
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "queued"],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "queued"],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "availability": {
      "enum": ["live", "stale"]
    }
  }
}

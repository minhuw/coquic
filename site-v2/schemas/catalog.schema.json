{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.dev/site-v2/schemas/catalog.schema.json",
  "title": "CoQUIC V2 content and scenario catalogs",
  "$defs": {
    "contentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "title", "description", "category", "keywords", "sourcePath"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "route": { "type": "string", "pattern": "^/" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "enum": ["route", "documentation", "blog", "dashboard", "tool"] },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "sourcePath": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lossRatio", "bandwidthBitsPerSecond", "oneWayDelayMs"],
      "properties": {
        "lossRatio": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "bandwidthBitsPerSecond": { "type": "integer", "minimum": 500000, "maximum": 100000000 },
        "oneWayDelayMs": { "type": "integer", "minimum": 50, "maximum": 2500 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "defaultNetwork", "controls", "milestones"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "defaultNetwork": { "$ref": "#/$defs/network" },
        "controls": {
          "type": "array",
          "items": { "enum": ["loss", "bandwidth", "delay", "pause", "step"] },
          "uniqueItems": true
        },
        "milestones": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "contentCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "data"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/contentEntry" } }
      }
    },
    "scenarioCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "data"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/scenario" }, "minItems": 1 }
      }
    }
  }
}

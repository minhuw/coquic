{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.dev/site-v2/schemas/common.schema.json",
  "title": "CoQUIC V2 common types",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri-reference" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "mediaType", "byteSize", "truncated"],
      "properties": {
        "availability": {
          "enum": ["available", "notProduced", "unavailable", "redacted"]
        },
        "url": { "type": ["string", "null"], "format": "uri-reference" },
        "mediaType": { "type": "string", "minLength": 1 },
        "filename": { "type": ["string", "null"] },
        "byteSize": { "type": ["integer", "null"], "minimum": 0 },
        "originalByteSize": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": {
            "required": ["url", "filename"],
            "properties": {
              "url": { "type": "string", "minLength": 1, "format": "uri-reference" },
              "filename": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "availability": { "const": "redacted" } } },
          "then": { "properties": { "url": { "type": "null" } } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "event", "commit", "completeness", "warnings"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "commit": {
          "anyOf": [
            { "$ref": "#/$defs/gitCommit" },
            { "type": "null" }
          ]
        },
        "runId": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "size", "totalItems", "totalPages"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "totalItems": { "type": "integer", "minimum": 0 },
        "totalPages": { "type": "integer", "minimum": 1 }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "completion", "total"],
      "properties": {
        "prompt": { "type": "integer", "minimum": 0 },
        "completion": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "coveredTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "code", "requestId"],
      "properties": {
        "type": { "type": "string", "format": "uri-reference" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "detail": { "type": "string" },
        "instance": { "type": "string", "format": "uri-reference" },
        "requestId": { "$ref": "#/$defs/id" },
        "retryAfterSeconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}

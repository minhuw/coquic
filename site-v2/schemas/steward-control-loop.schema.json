{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.example.test/schemas/steward-control-loop.schema.json",
  "title": "Raw Steward control-loop archive",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochId",
        "formatVersion",
        "taskFormatVersion",
        "policy",
        "startedAt"
      ],
      "properties": {
        "epochId": {"$ref": "#/$defs/id"},
        "formatVersion": {"const": "1.0"},
        "taskFormatVersion": {"const": "1.0"},
        "policy": {"const": "post-steward-2.0"},
        "startedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "availability", "byteSize", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)*$"
        },
        "availability": {
          "enum": ["available", "partial", "missing", "unavailable"]
        },
        "byteSize": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"},
        "mode": {"type": "string"}
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetchId",
        "provider",
        "status",
        "startedAt",
        "completedAt",
        "itemCount",
        "newItemCount",
        "hasMore",
        "error",
        "summary"
      ],
      "properties": {
        "fetchId": {"$ref": "#/$defs/id"},
        "provider": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "error"]},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "itemCount": {"type": "integer", "minimum": 0},
        "newItemCount": {"type": "integer", "minimum": 0},
        "hasMore": {"type": "boolean"},
        "error": {"type": ["string", "null"]},
        "summary": {"type": "string"}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalId",
        "provider",
        "fingerprint",
        "status",
        "createdAt",
        "updatedAt",
        "transition"
      ],
      "properties": {
        "signalId": {"$ref": "#/$defs/id"},
        "provider": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["pending", "planned", "superseded", "errored"]
        },
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "updatedAt": {"$ref": "#/$defs/timestamp"},
        "transition": {"type": ["string", "null"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "fetchId",
        "provider",
        "kind",
        "fingerprint",
        "title",
        "summary",
        "severity",
        "location",
        "links",
        "normalized",
        "canonicalSignalId",
        "dedupeResult",
        "observedAt"
      ],
      "properties": {
        "observationId": {"$ref": "#/$defs/id"},
        "fetchId": {"$ref": "#/$defs/id"},
        "provider": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "severity": {"type": ["string", "null"]},
        "location": {"type": ["object", "null"]},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "normalized": {"type": "object"},
        "canonicalSignalId": {"$ref": "#/$defs/id"},
        "dedupeResult": {"enum": ["new", "existing"]},
        "observedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalId",
        "fromStatus",
        "toStatus",
        "plannerRunId",
        "reasonCode"
      ],
      "properties": {
        "signalId": {"$ref": "#/$defs/id"},
        "fromStatus": {
          "enum": ["pending", "planned", "superseded", "errored"]
        },
        "toStatus": {
          "enum": ["pending", "planned", "superseded", "errored"]
        },
        "plannerRunId": {
          "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "wakeup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wakeupId",
        "reason",
        "status",
        "createdAt",
        "consumedAt",
        "inputSignalIds"
      ],
      "properties": {
        "wakeupId": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "consumed"]},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "consumedAt": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "inputSignalIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycleId",
        "reason",
        "startedAt",
        "completedAt",
        "runtimeState",
        "inputSignalIds"
      ],
      "properties": {
        "cycleId": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "runtimeState": {"type": "string", "minLength": 1},
        "inputSignalIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "plannerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannerRunId",
        "epochId",
        "state",
        "startedAt",
        "completedAt",
        "inputSignalIds",
        "activeTaskIds",
        "prompt",
        "artifacts",
        "result",
        "diagnostics"
      ],
      "properties": {
        "plannerRunId": {"$ref": "#/$defs/id"},
        "epochId": {"$ref": "#/$defs/id"},
        "state": {
          "enum": [
            "claimed",
            "running",
            "succeeded",
            "failed",
            "interrupted",
            "cancelled"
          ]
        },
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "inputSignalIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "activeTaskIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "prompt": {"type": ["object", "null"]},
        "artifacts": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifact"}
        },
        "result": {"type": ["object", "null"]},
        "diagnostics": {"type": "object"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "plannerRunId",
        "ordinal",
        "outcome",
        "reasonCode",
        "signalIds",
        "dedupeKey",
        "taskId",
        "proposal"
      ],
      "properties": {
        "proposalId": {"$ref": "#/$defs/id"},
        "plannerRunId": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 1},
        "outcome": {
          "enum": [
            "accepted",
            "invalid",
            "policy_rejected",
            "duplicate",
            "capacity_skipped"
          ]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "signalIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "dedupeKey": {"type": ["string", "null"], "maxLength": 160},
        "taskId": {
          "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "proposal": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {"enum": ["accepted", "duplicate"]}
            }
          },
          "then": {"properties": {"taskId": {"$ref": "#/$defs/id"}}}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "edgeType", "sourceId", "targetId", "createdAt"],
      "properties": {
        "edgeId": {"$ref": "#/$defs/id"},
        "edgeType": {
          "enum": [
            "observation_signal",
            "signal_planner_run",
            "planner_proposal",
            "signal_proposal",
            "proposal_task"
          ]
        },
        "sourceId": {"$ref": "#/$defs/id"},
        "targetId": {"$ref": "#/$defs/id"},
        "createdAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "epochId",
        "sequence",
        "occurredAt",
        "kind",
        "payload"
      ],
      "properties": {
        "eventId": {"$ref": "#/$defs/id"},
        "epochId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "kind": {"type": "string"},
        "payload": {"type": "object"}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "kind": {"enum": ["signal_fetch.started", "signal_fetch.finished"]},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fetch"],
                  "properties": {"fetch": {"$ref": "#/$defs/fetch"}}
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "signal.created"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["signal"],
                  "properties": {"signal": {"$ref": "#/$defs/signal"}}
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "signal.observation"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["observation"],
                  "properties": {
                    "observation": {"$ref": "#/$defs/observation"}
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "signal.transition"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["transition"],
                  "properties": {
                    "transition": {"$ref": "#/$defs/transition"}
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "scheduler.wakeup"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["wakeup"],
                  "properties": {"wakeup": {"$ref": "#/$defs/wakeup"}}
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "daemon.cycle"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cycle"],
                  "properties": {"cycle": {"$ref": "#/$defs/cycle"}}
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "planner.started"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["plannerRun"],
                  "properties": {
                    "plannerRun": {"$ref": "#/$defs/plannerRun"}
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "planner.finished"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["plannerRunId", "state", "result", "diagnostics"],
                  "properties": {
                    "plannerRunId": {"$ref": "#/$defs/id"},
                    "state": {
                      "enum": ["succeeded", "failed", "interrupted", "cancelled"]
                    },
                    "result": {"type": "object"},
                    "diagnostics": {"type": "object"}
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "planner.proposal"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["proposal"],
                  "properties": {
                    "proposal": {"$ref": "#/$defs/proposal"}
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "graph.edge"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["edge"],
                  "properties": {"edge": {"$ref": "#/$defs/edge"}}
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "daemon.runtime"},
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state"],
                  "properties": {
                    "state": {"enum": ["running", "stopping"]},
                    "instanceId": {"$ref": "#/$defs/id"},
                    "forced": {"type": "boolean"}
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "epochId",
        "plannerRunId",
        "terminalState",
        "completedAt",
        "files"
      ],
      "properties": {
        "manifestVersion": {"const": "1.0"},
        "epochId": {"$ref": "#/$defs/id"},
        "plannerRunId": {"$ref": "#/$defs/id"},
        "terminalState": {
          "enum": ["succeeded", "failed", "interrupted", "cancelled"]
        },
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "files": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"},
          "minItems": 1
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochId",
        "generatedAt",
        "providerState",
        "schedulerState",
        "runtimeState",
        "counts",
        "pendingSignalIds",
        "archive"
      ],
      "properties": {
        "epochId": {"$ref": "#/$defs/id"},
        "generatedAt": {"$ref": "#/$defs/timestamp"},
        "providerState": {"type": "object"},
        "schedulerState": {"type": "object"},
        "runtimeState": {"type": "object"},
        "counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "pendingSignalIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "activePlannerRunId": {
          "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "retry": {"type": "object"},
        "archive": {"type": "object"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coquic.dev/site-v2/schemas/steward-dataset.schema.json",
  "title": "CoQUIC raw Steward task archive",
  "description": "The post-Steward-2.0 task-tree contract. Metadata is public by placement; raw record payloads are opaque.",
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "An opaque path-safe identifier. It is never derived from a display label."
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[^/]*(?:/|$))[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
      "description": "A forward-slash relative path with no absolute, parent, backslash, NUL, hidden, temporary, or symlink component."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "availability": {
      "type": "string",
      "enum": ["available", "partial", "missing", "unavailable", "notProduced"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lifecycle", "availability", "mediaType", "byteSize", "sha256", "requiredAtTerminal", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "lifecycle": {
          "enum": ["live", "terminal", "optional"],
          "description": "Live artifacts may grow or be atomically replaced; terminal artifacts freeze with the task."
        },
        "availability": { "$ref": "#/$defs/availability" },
        "mediaType": { "type": ["string", "null"], "minLength": 1 },
        "byteSize": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "requiredAtTerminal": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": {
            "properties": {
              "mediaType": { "type": "string", "minLength": 1 },
              "byteSize": { "type": "integer", "minimum": 0 },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "availability": { "const": "partial" } } },
          "then": {
            "properties": { "reason": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": {
            "properties": {
              "availability": { "enum": ["missing", "unavailable", "notProduced"] }
            }
          },
          "then": {
            "properties": {
              "byteSize": { "type": "null" },
              "sha256": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "description": "An explicit reference to an owning raw artifact. Missing and partial values are not fabricated as empty bytes."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "promptTokens", "completionTokens", "totalTokens", "sourcePath", "reason"],
      "properties": {
        "availability": { "enum": ["available", "partial", "unavailable"] },
        "promptTokens": { "type": ["integer", "null"], "minimum": 0 },
        "completionTokens": { "type": ["integer", "null"], "minimum": 0 },
        "totalTokens": { "type": ["integer", "null"], "minimum": 0 },
        "sourcePath": {
          "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }]
        },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": {
            "properties": {
              "promptTokens": { "type": "integer", "minimum": 0 },
              "completionTokens": { "type": "integer", "minimum": 0 },
              "totalTokens": { "type": "integer", "minimum": 0 },
              "sourcePath": { "$ref": "#/$defs/safePath" },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "availability": { "const": "partial" } } },
          "then": {
            "properties": { "reason": { "type": "string", "minLength": 1 } },
            "anyOf": [
              { "properties": { "promptTokens": { "type": "integer" } } },
              { "properties": { "completionTokens": { "type": "integer" } } },
              { "properties": { "totalTokens": { "type": "integer" } } }
            ]
          }
        },
        {
          "if": { "properties": { "availability": { "const": "unavailable" } } },
          "then": {
            "properties": {
              "promptTokens": { "type": "null" },
              "completionTokens": { "type": "null" },
              "totalTokens": { "type": "null" },
              "sourcePath": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "description": "Usage evidence keeps partial and unavailable values explicit; a missing value is never converted to zero."
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "estimatedMicroUsd", "currency", "model", "pricingSource", "reason"],
      "properties": {
        "availability": { "enum": ["available", "partial", "unavailable"] },
        "estimatedMicroUsd": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "pricingSource": { "type": ["string", "null"], "minLength": 1 },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": {
            "properties": {
              "estimatedMicroUsd": { "type": "integer", "minimum": 0 },
              "currency": { "type": "string", "const": "USD" },
              "model": { "type": "string", "minLength": 1 },
              "pricingSource": { "type": "string", "minLength": 1 },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "availability": { "const": "partial" } } },
          "then": {
            "properties": { "reason": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "availability": { "const": "unavailable" } } },
          "then": {
            "properties": {
              "estimatedMicroUsd": { "type": "null" },
              "currency": { "type": "null" },
              "pricingSource": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "description": "Estimated cost uses integer micro-USD and names model/pricing provenance when available."
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epochId", "formatVersion", "policy", "startedAt"],
      "properties": {
        "epochId": { "$ref": "#/$defs/safeId" },
        "formatVersion": { "type": "string", "const": "1.0" },
        "policy": { "type": "string", "const": "post-steward-2.0" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "endedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "description": "The one immutable archive epoch. Only tasks created after its start belong below tasks/."
    },
    "pipelineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineId", "ordinal", "path"],
      "properties": {
        "pipelineId": { "$ref": "#/$defs/safeId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/safePath" }
      }
    },
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "role", "roleOrdinal", "state", "path"],
      "properties": {
        "runId": { "$ref": "#/$defs/safeId" },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roleOrdinal": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["running", "succeeded", "failed", "interrupted", "cancelled"] },
        "path": { "$ref": "#/$defs/safePath" }
      }
    },
    "validationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationId", "ordinal", "path"],
      "properties": {
        "validationId": { "$ref": "#/$defs/safeId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/safePath" }
      }
    },
    "reviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "kind", "ordinal", "path"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["raw", "effective"] },
        "ordinal": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/safePath" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "epochId", "status", "promptPath", "eventsPath", "createdAt", "updatedAt", "currentPipelineId", "summary", "pipelines"],
      "properties": {
        "taskId": { "$ref": "#/$defs/safeId" },
        "epochId": { "$ref": "#/$defs/safeId" },
        "status": {
          "enum": ["queued", "running", "reviewing", "integrating", "succeeded", "pushed", "no_changes", "blocked", "failed", "cancelled"]
        },
        "promptPath": { "$ref": "#/$defs/safePath" },
        "eventsPath": { "$ref": "#/$defs/safePath" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "currentPipelineId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "text"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        "pipelines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pipelineRef" }
        },
        "terminalStatusObservedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "manifestPath": {
          "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }]
        }
      },
      "description": "Task metadata is live and may be atomically replaced. A terminal Steward status is not terminal archive verification."
    },
    "archiveImportLag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "reason"],
      "properties": {
        "category": { "$ref": "#/$defs/safeId" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "archiveTaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "status", "archiveState", "currentPipelineId", "updatedAt", "lastSuccessfulImportAt", "importLag"],
      "properties": {
        "taskId": { "$ref": "#/$defs/safeId" },
        "status": {
          "enum": ["queued", "running", "reviewing", "integrating", "succeeded", "pushed", "no_changes", "blocked", "failed", "cancelled"]
        },
        "archiveState": { "enum": ["live", "incomplete", "verified", "corrupt"] },
        "currentPipelineId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "lastSuccessfulImportAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "importLag": {
          "anyOf": [{ "$ref": "#/$defs/archiveImportLag" }, { "type": "null" }]
        }
      }
    },
    "archiveFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastSyncAt", "lastSuccessfulImportAt"],
      "properties": {
        "lastSyncAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "lastSuccessfulImportAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "taskListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "data"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epochId", "tasks", "freshness"],
          "properties": {
            "epochId": { "$ref": "#/$defs/safeId" },
            "tasks": {
              "type": "array",
              "items": { "$ref": "#/$defs/archiveTaskSummary" }
            },
            "freshness": { "$ref": "#/$defs/archiveFreshness" }
          }
        }
      },
      "description": "The future V2 API envelope for ordered raw-archive task summaries. It is distinct from task.json on disk."
    },
    "identity": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "resultPath", "commit", "startedAt", "completedAt"],
      "properties": {
        "state": { "enum": ["pending", "succeeded", "failed", "conflict", "unavailable"] },
        "resultPath": {
          "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }]
        },
        "commit": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/gitCommit" }, { "type": "null" }]
        },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineId", "taskId", "ordinal", "trigger", "parentPipelineId", "phase", "state", "baseIdentity", "inputIdentity", "outputIdentity", "patchIdentity", "startedAt", "updatedAt", "completedAt", "inputs", "patches", "validations", "reviews", "integration", "runs"],
      "properties": {
        "pipelineId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "trigger": { "enum": ["initial", "validation-repair", "review-repair", "integration-rebase", "integration-conflict", "push-race"] },
        "parentPipelineId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "phase": { "enum": ["planning", "implementation", "validation", "review", "integration", "complete"] },
        "state": { "enum": ["active", "succeeded", "failed", "blocked", "cancelled", "interrupted", "superseded"] },
        "baseIdentity": { "$ref": "#/$defs/identity" },
        "inputIdentity": { "$ref": "#/$defs/identity" },
        "outputIdentity": { "$ref": "#/$defs/identity" },
        "patchIdentity": { "$ref": "#/$defs/identity" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "patches": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRef" }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewRef" }
        },
        "integration": { "$ref": "#/$defs/integration" },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runRef" }
        }
      },
      "description": "A bounded pass. A repair or base change creates a child pipeline; a daemon restart does not."
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationId", "taskId", "pipelineId", "ordinal", "command", "state", "startedAt", "completedAt", "result", "outputPath", "output"],
      "properties": {
        "validationId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "pipelineId": { "$ref": "#/$defs/safeId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "command": { "type": "string", "minLength": 1 },
        "state": { "enum": ["running", "completed", "unavailable"] },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "result": { "enum": ["pass", "fail", "skipped", "unavailable"] },
        "outputPath": { "$ref": "#/$defs/safePath" },
        "output": { "$ref": "#/$defs/artifact" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "taskId", "pipelineId", "ordinal", "kind", "role", "state", "verdict", "findings", "artifact"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "pipelineId": { "$ref": "#/$defs/safeId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["raw", "effective"] },
        "role": { "type": "string", "minLength": 1 },
        "state": { "enum": ["available", "partial", "unavailable"] },
        "verdict": { "enum": ["approve", "request-changes", "unknown", "unavailable"] },
        "findings": { "type": "array", "items": { "type": "string" } },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "signal", "reason"],
      "properties": {
        "code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"], "minLength": 1 },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "path"],
      "properties": {
        "status": { "enum": ["available", "partial", "unavailable"] },
        "summary": { "type": ["string", "null"] },
        "path": {
          "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }]
        }
      }
    },
    "runArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "activities", "telemetry", "lastMessage", "result", "toolChangesManifest", "toolChangesSummary"],
      "properties": {
        "codex": { "$ref": "#/$defs/artifact" },
        "activities": { "$ref": "#/$defs/artifact" },
        "telemetry": { "$ref": "#/$defs/artifact" },
        "lastMessage": { "$ref": "#/$defs/artifact" },
        "result": { "$ref": "#/$defs/artifact" },
        "toolChangesManifest": { "$ref": "#/$defs/artifact" },
        "toolChangesSummary": { "$ref": "#/$defs/artifact" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "pipelineId", "role", "roleOrdinal", "sessionId", "resumeOfRunId", "parentRunId", "retryOfRunId", "state", "startedAt", "updatedAt", "completedAt", "model", "reasoning", "exit", "result", "usage", "cost", "artifacts"],
      "properties": {
        "runId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "pipelineId": { "$ref": "#/$defs/safeId" },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roleOrdinal": { "type": "integer", "minimum": 1 },
        "sessionId": { "$ref": "#/$defs/safeId" },
        "resumeOfRunId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "parentRunId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "retryOfRunId": {
          "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
        },
        "state": { "enum": ["running", "succeeded", "failed", "interrupted", "cancelled"] },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "reasoning": { "type": ["string", "null"], "minLength": 1 },
        "exit": {
          "anyOf": [{ "$ref": "#/$defs/exit" }, { "type": "null" }]
        },
        "result": { "$ref": "#/$defs/runResult" },
        "usage": {
          "anyOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }]
        },
        "cost": {
          "anyOf": [{ "$ref": "#/$defs/cost" }, { "type": "null" }]
        },
        "artifacts": { "$ref": "#/$defs/runArtifacts" }
      },
      "description": "One Steward-launched codex exec process. Every process has one run directory; recovery is a new run."
    },
    "manifestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteSize", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "epochId", "taskId", "completionIdentity", "terminalStatus", "completedAt", "files"],
      "properties": {
        "manifestVersion": { "type": "string", "const": "1.0" },
        "epochId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "completionIdentity": { "$ref": "#/$defs/safeId" },
        "terminalStatus": {
          "enum": ["succeeded", "pushed", "no_changes", "blocked", "failed", "cancelled"]
        },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/manifestFile" },
          "description": "The canonical lexicographically ordered list of every durable regular file beneath the task directory except manifest.json."
        }
      },
      "description": "Terminal-only integrity evidence. It is written after the task outcome and external results are frozen; it is not a live publication commit point."
    }
  }
}

{
  "name": "coquic-demo",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "prepare:site": "node scripts/prepare-public-assets.mjs && node scripts/build-transcript-dataset.mjs && node scripts/build-search-index.mjs",
    "predev": "npm run prepare:site",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "lint:ts": "eslint . --max-warnings=0",
    "lint:css": "node scripts/check-stylelint-baseline.mjs",
    "lint:css:update": "node scripts/check-stylelint-baseline.mjs --update",
    "lint": "npm run lint:ts && npm run lint:css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "npm run prepare:site",
    "build": "next build",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "build:wasm-deps": "cd ../.. && nix develop .#wasm --option fallback true -c bash scripts/build-boringssl-wasm.sh",
    "compile:wasm": "cd ../.. && nix develop .#wasm --option fallback true -c zig build wasm-quic -Doptimize=ReleaseSmall --summary all",
    "smoke:wasm": "cd ../.. && node scripts/wasm-quic-smoke.mjs zig-out/share/wasm-quic/coquic-wasm-quic.wasm",
    "build:wasm": "npm run build:wasm-deps && npm run compile:wasm && npm run smoke:wasm",
    "build:demo": "npm run build:wasm && npm run build",
    "package:demo": "cd ../.. && site/deploy/package-demo.sh",
    "start": "node .next/standalone/server.js"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "1.1.17",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.14",
    "@types/yauzl": "^3.4.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "minisearch": "^7.2.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.15",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    }
  }
}
